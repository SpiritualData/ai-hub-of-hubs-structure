 {
  "id": "session-ask-number-picks-option",
  "kind": "ask",
  "origin": "rule: a number answers an open question with that option",
  "args": {
   "lines": [
    "find it\n",
    "2\n",
    "/quit\n"
   ],
   "replies": {
    "find it": {
     "answer": "Need a choice.",
     "events": [
      {
       "type": "decision",
       "text": "",
       "data": {
        "decision_id": "d1",
        "question": "Which source?",
        "options": [
         "Web",
         "Library"
        ]
       }
      }
     ]
    },
    "Library": {
     "answer": "Used the library.",
     "events": []
    }
   },
   "must_show": [
    "Which source?",
    "1. Web",
    "Used the library."
   ],
   "setup_error": false
  },
  "expect": {
   "door_calls": [
    "find it",
    "Library"
   ],
   "missing": [],
   "exit_code": 0,
   "ended": true
  }
 },
 {
  "id": "session-ask-free-text",
  "kind": "ask",
  "origin": "rule: any other text answers an open question as typed",
  "args": {
   "lines": [
    "plan\n",
    "the second draft\n",
    "/quit\n"
   ],
   "replies": {
    "plan": {
     "answer": "Which draft?",
     "events": [
      {
       "type": "decision",
       "text": "",
       "data": {
        "decision_id": "d2",
        "question": "Which draft?"
       }
      }
     ]
    },
    "the second draft": {
     "answer": "Using it.",
     "events": []
    }
   },
   "must_show": [
    "Which draft?",
    "Using it."
   ],
   "setup_error": false
  },
  "expect": {
   "door_calls": [
    "plan",
    "the second draft"
   ],
   "missing": [],
   "exit_code": 0,
   "ended": true
  }
 },
 {
  "id": "session-ask-folded-by-later",
  "kind": "ask",
  "origin": "rule: /later folds a question without answering it, and the next line is a new message",
  "args": {
   "lines": [
    "plan\n",
    "/later\n",
    "other\n",
    "/quit\n"
   ],
   "replies": {
    "plan": {
     "answer": "Which draft?",
     "events": [
      {
       "type": "decision",
       "text": "",
       "data": {
        "decision_id": "d3",
        "question": "Which draft?"
       }
      }
     ]
    },
    "other": {
     "answer": "Fine.",
     "events": []
    }
   },
   "must_show": [
    "Which draft?",
    "Fine."
   ],
   "setup_error": false
  },
  "expect": {
   "door_calls": [
    "plan",
    "other"
   ],
   "missing": [],
   "exit_code": 0,
   "ended": true
  }
 },
 {
