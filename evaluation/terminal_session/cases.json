 {
  "id": "session-ask-number-picks-option",
  "kind": "ask",
  "origin": "rule: a number answers an open question with that option",
  "args": {
   "lines": [
    "find it\n",
    "2\n",
    "/quit\n"
   ],
   "replies": {
    "find it": {
     "answer": "Need a choice.",
     "events": [
      {
       "type": "decision",
       "text": "",
       "data": {
        "decision_id": "d1",
        "question": "Which source?",
        "options": [
         "Web",
         "Library"
        ]
       }
      }
     ]
    },
    "Library": {
     "answer": "Used the library.",
     "events": []
    }
   },
   "must_show": [
    "Which source?",
    "1. Web",
    "Used the library."
   ],
   "setup_error": false
  },
  "expect": {
   "door_calls": [
    "find it",
    "Library"
   ],
   "missing": [],
   "exit_code": 0,
   "ended": true
  }
 },
