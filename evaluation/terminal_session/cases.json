[
 {
  "id": "session-one-turn",
  "kind": "turn",
  "origin": "rule: a line is run once and its answer shown",
  "args": {
   "lines": [
    "hello\n",
    "/quit\n"
   ],
   "replies": {
    "hello": {
     "answer": "Hi there.",
     "events": []
    }
   },
   "must_show": [
    "Hi there."
   ],
   "setup_error": false
  },
  "expect": {
   "door_calls": [
    "hello"
   ],
   "missing": [],
   "exit_code": 0,
   "ended": true
  }
 },
