$mistral_orange: #FF8205;

* {
    scrollbar-size: 1 1;
}

*:ansi {
    link-color-hover: $ansi-background;
}

Screen {
    background: transparent;
}

Horizontal {
    width: 100%;
    height: auto;
}

TextArea > .text-area--cursor {
    color: $foreground;
}

#chat {
    layout: stream;
    height: 1fr;
    width: 100%;
    background: transparent;
    padding: 0;
    align-vertical: bottom;
}

#loading-area {
    height: auto;
    width: 100%;
    background: transparent;
    padding: 1 0 0 0;
    layout: horizontal;
    align: left middle;
}

#loading-area-content {
    width: 1fr;
    height: auto;
    align: left middle;
}

#inline-notice {
    width: auto;
    height: 1;
    color: $text-muted;
    &:ansi {
        text-style: dim;
    }
}

#bottom-app-container,
#input-container {
    height: auto;
    width: 100%;
    background: transparent;
}

.queue-header-message {
    margin-top: 1;
    margin-bottom: 0;
    width: 100%;
    height: auto;
}

.queue-header-container {
    width: 100%;
    height: auto;
}

.queue-header-content {
    width: auto;
    height: auto;
    text-style: bold italic;
    color: $mistral_orange;
}

.queue-header-separator {
    width: 100%;
    height: 1;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}

/* Pinned todo line. `height: 1` is load-bearing: this sits between the input
   and the bottom bar, so any growth would shove the input box up mid-keystroke. */
#todo-status-row {
    height: 1;
    width: 100%;
    background: transparent;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;

    &:hover {
        color: $foreground;
        text-style: underline;
    }
}

#bottom-bar {
    height: auto;
    width: 100%;
    background: transparent;
    padding: 0;
    align: left middle;
    layout: horizontal;
}

#messages {
    layout: stream;
    width: 100%;
    height: auto;
    text-align: left;
    margin-top: 1;
    margin-bottom: 0;
}

#subagent-transcripts {
    display: none;
    layout: stream;
    width: 100%;
    height: auto;
    text-align: left;
    margin-top: 1;
    margin-bottom: 0;
}

.subagent-transcript {
    layout: stream;
    width: 100%;
    height: auto;
}

#input-container {
    padding: 0;
    margin: 0;
}

#subagent-list {
    display: none;
    width: 100%;
    height: auto;
    max-height: 7;
    padding: 0 1;
    color: $foreground;
    border: none;
    background: transparent;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    pointer: pointer;

    &.subagent-view {
        border-top: solid $foreground;
        border-title-align: right;
        border-title-color: $foreground;
    }
}

#subagent-list > .option-list--option-hover {
    color: $primary-darken-1;
}

#subagent-list > .option-list--option-highlighted,
#subagent-list:focus > .option-list--option-highlighted {
    color: $primary;
}

#subagent-list:focus {
    border: none;
}

#subagent-list.subagent-view:focus {
    border-top: solid $foreground;
}

#subagent-list > .option-list--option-highlighted,
#subagent-list:focus > .option-list--option-highlighted {
    background: $surface;
}

#completion-popup {
    display: none;
    width: 100%;
    height: auto;
    color: $foreground;
    background: $background;
    border: solid $foreground-muted;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
    /* max-height and padding set in completion_popup.py */
}

OptionList, OptionList:focus {
    background: $background;
    background-tint: transparent;
}

#completion-popup _CompletionRow {
    height: auto;
    width: 1fr;
}

#completion-popup _CompletionItem {
    height: auto;
}

#completion-popup .completion-command {
    /* width set per-row in completion_popup.py, capped to 30% of the popup */
    max-width: 30%;
    margin-right: 2;
    text-style: bold;
}

#completion-popup .completion-description {
    width: 1fr;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}

#completion-popup.completion-no-description .completion-command {
    max-width: 100%;
    width: 1fr;
    margin-right: 0;
}

#completion-popup.completion-no-description .completion-description {
    display: none;
}

#completion-popup _CompletionRow.completion-selected .completion-command {
    text-style: bold reverse;
}

#completion-popup _CompletionRow.completion-selected .completion-description {
    color: $foreground;
    text-style: italic;
}

#input-box {
    height: auto;
    width: 100%;
    background: transparent;
    border: none;
    border-top: solid $foreground-muted;
    border-bottom: solid $foreground-muted;
    border-title-align: right;
    border-title-color: $text-muted;

    &.border-warning {
        border-top: solid $warning;
        border-bottom: solid $warning;
        border-title-color: $warning;
    }

    &.border-safe {
        border-top: solid $success;
        border-bottom: solid $success;
        border-title-color: $success;
    }

    &.border-error {
        border-top: solid $error;
        border-bottom: solid $error;
        border-title-color: $error;
    }
}

#input-body {
    height: auto;
}

#prompt,
#prompt-spinner {
    width: auto;
    background: transparent;
    color: $mistral_orange;
    text-style: bold;
    padding: 0 1 0 0;
}

#input {
    width: 1fr;
    height: auto;
    min-height: 3;
    max-height: 50vh;
    background: transparent;
    color: $foreground;
    border: none;
    padding: 0;
    scrollbar-visibility: hidden;

    & .text-area--suggestion {
        color: $foreground;
        text-opacity: 45%;
    }

    &:ansi .text-area--suggestion {
        text-style: dim;
    }
}

ToastRack {
    align: left bottom;
    padding: 0;
    margin: 0 0 6 0;
}

Markdown {
    color: $foreground;

    .code_inline {
        color: $success;
        background: transparent;
        text-style: bold;
    }

    MarkdownFence {
        overflow-x: auto;
        scrollbar-size-horizontal: 1;
        max-width: 95%;
        background: transparent;

        & > Label {
            padding: 0;
        }
    }

    MarkdownTable {
        background: transparent;
    }

    MarkdownBlockQuote {
        background: transparent;
        border-left: outer $foreground-muted;
    }

    MarkdownBullet,
    MarkdownBulletList,
    MarkdownOrderedList {
        color: $foreground;
    }
}

.user-message {
    margin-top: 1;
    width: 100%;
    height: auto;

    &.pending {
        margin-top: 0;

        .user-message-prompt,
        .user-message-content {
            text-style: italic;
        }
        .user-message-separator {
            display: none;
        }
        .user-message-wrapper {
            margin-top: 0;
        }
    }

    &.no-separator .user-message-separator {
        display: none;
    }

    &.follows-user {
        margin-top: 0;

        .user-message-wrapper {
            margin-top: 0;
        }
    }
}

.user-message-wrapper {
    margin-top: 1;
    width: 100%;
    height: auto;
}

.user-message-container {
    width: 100%;
    height: auto;
}

.user-message-severity .user-message-container {
    padding: 0 1;
}

.user-message-info .user-message-container {
    border-left: heavy $success;
}

.user-message-info .user-message-content {
    color: $success;
}

.user-message-warning .user-message-container {
    border-left: heavy $warning;
}

.user-message-warning .user-message-content {
    color: $warning;
}

.user-message-error .user-message-container {
    border-left: heavy $error;
}

.user-message-error .user-message-content {
    color: $error;
}

.user-message-attachments {
    width: 100%;
    height: auto;
    padding: 0 2 0 2;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}

.user-message-attachment-line {
    width: 100%;
    height: auto;
}

.user-message-attachment-label {
    width: auto;
    height: auto;
}

.user-message-attachment-link {
    width: auto;
    height: auto;
}

.user-message-prompt {
    width: auto;
    height: auto;
    color: $mistral_orange;
    text-style: bold;
}

.user-message-content {
    width: 1fr;
    height: auto;
    text-style: bold;
}

.slash-command-message {
    .user-message-content {
        color: $mistral_orange;
    }
}

.user-message-separator {
    width: 100%;
    height: 1;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}

.assistant-message {
    layout: stream;
    margin-top: 1;
    width: 100%;
    height: auto;
    padding: 0 2 0 2;

    Markdown {
        width: 100%;
        height: auto;
        padding: 0;
        margin: 0;

        & > MarkdownBlock:last-child {
            margin-bottom: 0;
        }
    }
}

.reasoning-message {
    margin-top: 1;
    width: 100%;
    height: auto;
}

.reasoning-message-wrapper {
    width: 100%;
    height: auto;
}

.reasoning-message-header {
    width: 100%;
    height: auto;
    pointer: pointer;
}

.reasoning-indicator {
    width: auto;
    height: auto;
    color: $text-muted;
    margin-right: 1;

    &:ansi {
        text-style: dim;
    }
}

.reasoning-collapsed-text {
    width: auto;
    height: auto;
    color: $text-muted;
    text-style: italic;

    &:ansi {
        text-style: dim;
    }
}

.reasoning-message-content {
    layout: stream;
    width: 100%;
    height: auto;
    padding: 0 2 0 2;
    margin: 0;
    color: $text-muted;
    text-style: italic;

    &:ansi {
        text-style: dim;
    }

    * {
        color: $text-muted;
        text-style: italic;

        &:ansi {
            text-style: dim;
        }
    }

    & > MarkdownBlock:last-child {
        margin-bottom: 0;
    }
}

.interrupt-message,
.error-message,
.warning-message,
.user-command-message {
    margin-top: 0;
    margin-bottom: 0;
    height: auto;
    width: 100%;
}

.interrupt-container,
.error-container,
.warning-container,
.user-command-container {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
}

.interrupt-border,
.error-border,
.warning-border,
.user-command-border {
    width: auto;
    height: 100%;
    padding: 0 1 0 2;
}

.interrupt-content {
    width: 1fr;
    height: auto;
    margin: 0;
    padding-right: 2;
    color: $warning;
}

.error-content {
    width: 1fr;
    height: auto;
    margin: 0;
    padding-right: 2;
    color: $error;
    text-style: bold;
}

.warning-content {
    width: 1fr;
    height: auto;
    margin: 0;
    padding-right: 2;
    color: $warning;
}

.user-command-content {
    width: 1fr;
    height: auto;
    margin: 0;
    padding-right: 2;

    Markdown {
        margin: 0;
        padding: 0;

        & > MarkdownBlock:first-child {
            margin-top: 0;
        }

        & > MarkdownBlock:last-child {
            margin-bottom: 0;
        }

        /* Headings inside a command message carry no margins: a rule that
           touches one margin edge replaces the whole margin, so this zeroes
           top and bottom together. A heading therefore follows its content
           directly, and the gap before it is only the previous block's
           bottom margin. */
        MarkdownHeader {
            margin: 0;
        }
    }
}

.bash-output-message {
    margin-top: 1;
    width: 100%;
    height: auto;

    &:first-child {
        margin-top: 0;
    }

}

.bash-command-line {
    width: 100%;
    height: auto;
    margin: 0;
}

.bash-prompt {
    width: auto;
    height: auto;

    &.bash-pending {
        color: $foreground;
    }

    &.bash-success {
        color: $success;
    }

    &.bash-error {
        color: $error;
    }

    &.bash-interrupted {
        color: $warning;
    }
}

.bash-command {
    width: 1fr;
    height: auto;
}

.bash-output-container {
    width: 100%;
    height: auto;
    margin: 0;
}

.bash-output-border {
    width: auto;
    height: 100%;
    padding: 0 1 0 2;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}

.bash-output-body {
    width: 1fr;
    height: auto;
    padding-right: 2;
}

.bash-output {
    width: 1fr;
    height: auto;
}

.collapsible-section {
    width: 1fr;
    height: auto;
}

/* Overflow toggle (OverflowCollapsibleSection): a small "+N lines"/"show less"
   disclosure beneath the body -- shrinks to its content. */
.collapsible-toggle {
    width: auto;
    height: auto;
    margin-top: 0;
    pointer: pointer;
}

/* Header toggle (HeaderCollapsibleSection): a summary line on top. It fills the
   width so messages without suffixes ellipsis when collapsed and wrap when
   expanded; the triangle and verb stay fixed-width on the first line. */
.collapsible-toggle.header {
    width: 1fr;
}

.collapsible-toggle.header .status-indicator-text {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.collapsible-toggle.header.has-suffix .status-indicator-text {
    width: auto;
}

.collapsible-toggle.header.expanded .status-indicator-text {
    text-wrap: wrap;
    text-overflow: clip;
    text-opacity: 100%;

    /* Restore full contrast on expand (see the dim rule below). */
    &:ansi {
        text-style: none;
    }
}

/* Dim the collapsed summary (verb + message) so an expanded tool call stands
   out. text-opacity handles truecolor themes; ANSI themes can't blend colours,
   so they fall back to `text-style: dim`. The triangle keeps its full colour as
   the status affordance. Set per child because Textual styles don't cascade
   into child widgets. */
.collapsible-toggle.header .status-indicator-text {
    text-opacity: 55%;

    &:ansi {
        text-style: dim;
    }
}

.collapsible-toggle.header .collapsible-header-verb {
    text-opacity: 55%;

    &:ansi {
        text-style: bold dim;
    }
}

.collapsible-toggle.header.expanded .collapsible-header-verb {
    text-opacity: 100%;

    &:ansi {
        text-style: bold;
    }
}

.collapsible-triangle {
    width: auto;
    height: auto;
    color: $text-muted;
    margin-right: 1;

    /* Muted arrow (classic overflow, held error/skip): keep the muted intent
       under ANSI themes. success/error carry meaning, so clear the dim there. */
    &:ansi {
        text-style: dim;
    }

    &.success {
        color: $success;

        &:ansi {
            text-style: none;
        }
    }

    &.error {
        color: $error;

        &:ansi {
            text-style: none;
        }
    }
}

.collapsible-header-verb {
    width: auto;
    height: auto;
    margin-right: 1;
    text-style: bold;
    color: $primary;
}

.collapsible-toggle-label {
    width: auto;
    height: auto;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}

StatusMessage {
    width: 100%;
    height: auto;

    Horizontal {
        width: 100%;
        height: auto;
    }
}

.status-indicator-icon {
    width: auto;
    height: auto;
    color: $foreground;
    margin-right: 1;

    &.success {
        color: $success;
    }

    &.error {
        color: $error;
    }

    &.muted {
        color: $text-muted;

        &:ansi {
            text-style: dim;
        }
    }
}

.status-indicator-text {
    width: auto;
    height: auto;
    color: $foreground;
}

.status-indicator-suffix {
    width: auto;
    height: auto;
    margin-left: 1;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}

.compact-message,
.tool-call {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.tool-group {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.tool-group-header {
    width: 100%;
    height: auto;
}

/* Match the dimmed grey of expanded tool-call headers so the folded summary
   reads as the same muted line. text-opacity for truecolor themes; ANSI themes
   fall back to dim. */
.tool-group-header .status-indicator-text {
    text-opacity: 55%;

    &:ansi {
        text-style: dim;
    }
}

.tool-group-body {
    width: 100%;
    height: auto;
}

.tool-group-content {
    width: 1fr;
    height: auto;
    /* The inner pane also carries .tool-group for packing / parent checks;
       do not inherit that class's conversation-level top margin. */
    margin-top: 0;
}

.tool-call-header .status-indicator-text {
    /* 1fr (not auto) gives a definite width so long text wraps to the
       available space instead of measuring unwrapped and overflowing. */
    width: 1fr;
    text-wrap: wrap;
}

/* With a suffix (e.g. "(scratchpad)") the title takes its content width so the
   suffix sits directly after it instead of being pushed to the right edge by a
   1fr title that fills the row. */
.tool-call-header.has-suffix .status-indicator-text {
    width: auto;
    text-wrap: nowrap;
}

.tool-call-header.running.collapsible-result .status-indicator-text {
    text-opacity: 55%;

    &:ansi {
        text-style: dim;
    }
}

.tool-call-header.running.collapsible-result .collapsible-header-verb {
    text-opacity: 55%;

    &:ansi {
        text-style: bold dim;
    }
}

/* Children of a group are packed with no vertical gaps between them. */
.tool-group > .tool-call,
.tool-group > .tool-result,
.tool-group > .reasoning-message {
    margin-top: 0;
}

.tool-call-container {
    width: 100%;
    height: auto;
}

.tool-stream-message {
    width: 100%;
    height: auto;
    color: $text-muted;
    padding: 0 2 0 2;

    &:ansi {
        text-style: dim;
    }
}

.tool-result {
    width: 100%;
    height: auto;
    margin-top: 0;
    margin-left: 0;
    padding: 0;
    background: transparent;
    color: $foreground;

    &.has-gap {
        margin-top: 1;
    }

    &.error-text {
        color: $error;
    }

    &.warning-text {
        color: $warning;
    }
}

.tool-result-container {
    width: 100%;
    height: auto;
    margin-top: 0;
    padding: 0;
}

.tool-result-border {
    width: auto;
    height: 100%;
    padding: 0 1 0 2;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}

.tool-result-content {
    width: 1fr;
    height: auto;
    padding-right: 2;
}

.tool-result-widget {
    width: 100%;
    height: auto;
    color: $foreground;
}

.tool-result-widget Static {
    height: auto;
}

.tool-result-widget Markdown,
.tool-approval-widget Markdown {
    padding: 0;
    margin: 0;
}

.tool-result-widget Markdown > *,
.tool-approval-widget Markdown > * {
    margin-top: 0;
    margin-bottom: 0;
}

.tool-result-widget Markdown MarkdownFence,
.tool-approval-widget Markdown MarkdownFence {
    margin: 0;
    padding: 0;
    /* Override the 95% cap on plain-message fences: tool-result bodies should
       fill the width up to the content container's right padding. */
    max-width: 100%;
}

.tool-result-detail {
    height: auto;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}

.tool-result-detail {
    margin-top: 0;
}

.tool-result-warning {
    color: $warning;
}

.tool-result-approval-note {
    color: $text-muted;
}

.diff-scroll {
    width: 1fr;
    height: auto;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-size-horizontal: 1;

    .collapsible-section,
    VerticalGroup {
        width: auto;
    }
}

/* The whole diff renders as one DiffView. It must stay nowrap and grow to its
   content width so wide lines scroll horizontally in .diff-scroll. The two-class
   selector outranks `.tool-approval-widget Static { width: 100% }`, which would
   otherwise clamp the width and force the long line to wrap. The per-row band
   and gap color are painted in DiffView.render_line, not via CSS. */
.diff-scroll .diff-view {
    width: auto;
    min-width: 100%;
    height: auto;
    text-wrap: nowrap;
}

.todo-empty,
.todo-cancelled {
    height: auto;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}

.todo-pending {
    height: auto;
    color: $foreground;
}

.todo-in_progress {
    height: auto;
    color: $warning;
}

.todo-completed {
    height: auto;
    color: $success;
}

.loading-widget {
    width: 100%;
    height: auto;
    color: $text-muted;
}

.loading-container,
.loading-indicator,
.loading-status,
.loading-hint {
    width: auto;
    height: auto;
}

.loading-indicator {
    margin-right: 1;
}

.loading-status {
    width: auto;
    height: auto;
}

.loading-hint {
    width: auto;
    height: auto;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}

.loading-debounce {
    width: auto;
    height: auto;
    margin-left: 1;
}

#approval-app {
    width: 100%;
    /* height set by ApprovalApp._recompute_height; max-height below caps it */
    height: 1;
    max-height: 70vh;
    background: transparent;
    border: solid $foreground-muted;
    padding: 0 1;
    margin: 0;
}

#approval-options {
    width: 100%;
    height: auto;
}

#approval-content {
    width: 100%;
    height: 1fr;
}

.approval-tool-info-scroll {
    width: 100%;
    height: 1fr;
}

.approval-title {
    height: auto;
    text-style: bold;
    color: $warning;
}

.approval-reason {
    height: auto;
    color: $warning;
    margin-bottom: 1;
}

.approval-tool-info-container {
    width: 100%;
    height: auto;
}

.tool-approval-widget {
    width: 100%;
    height: auto;

    Static,
    Vertical {
        width: 100%;
        height: auto;
    }
}

.approval-option {
    height: auto;
    color: $foreground;
}

.approval-cursor-selected {
    &.approval-option-yes {
        color: $success;
        text-style: bold;
    }

    &.approval-option-no {
        color: $error;
        text-style: bold;
    }
}

.approval-option-selected {
    &.approval-option-yes {
        color: $foreground;
    }

    &.approval-option-no {
        color: $error;
    }
}

.approval-help {
    height: auto;
    margin-top: 1;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}

.approval-description {
    height: auto;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}

#question-app {
    width: 100%;
    height: auto;
    max-height: 70vh;
    background: transparent;
    border: solid $foreground-muted;
    padding: 0 1;
    margin: 0;
}

#question-content {
    width: 100%;
    height: auto;
}

.question-tabs {
    height: auto;
    color: $primary;
    margin-bottom: 1;
}

.question-title {
    height: auto;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.question-option {
    height: auto;
    color: $foreground;
}

.question-option-selected {
    color: $primary;
    text-style: bold;
}

.question-other-row {
    width: 100%;
    height: auto;
}

.question-other-prefix {
    width: auto;
    height: auto;
    color: $foreground;
}

.question-other-input {
    width: 1fr;
    height: auto;
    background: transparent;
    border: none;
    padding: 0;
}

.question-other-static {
    width: auto;
    height: auto;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}

.question-submit {
    height: auto;
    color: $foreground;
    margin-top: 1;
}

.question-footer-note {
    height: auto;
    color: $text-muted;
    text-style: italic;
    margin-top: 1;

    &:ansi {
        text-style: dim;
    }
}

.question-help {
    height: auto;
    color: $text-muted;
    margin-top: 1;

    &:ansi {
        text-style: dim;
    }
}

ExpandingBorder {
    width: auto;
    height: 100%;
    content-align: left bottom;
}

