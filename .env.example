# Generated by `esoi requirements`; edit the arms' declarations, not this file.
# Fill in the values you have; leave the rest blank.

# OpenAlex API key (secret)
# used by know-the-world:openalex_semantic_and_web
# signup: https://help.openalex.org/how-to-use-the-api/rate-limits-and-authentication
# docs: https://help.openalex.org/how-to-use-the-api/rate-limits-and-authentication
# pricing: https://help.openalex.org/how-to-use-the-api/rate-limits-and-authentication
# free tier: works with no key; a free key gives 10 times the keyless daily budget (each free account gets $1 a day, key works once its email is verified) (as of 2026-10-31)
# rate limit: 10 requests per second with no key, 30 with a free key; semantic search 1 request per second; the daily budget resets at midnight UTC (as of 2026-10-31)
# works without a key (keyless path); a key is optional
OPENALEX_API_KEY=

# Gemini API key (secret)
# used by search-backend:gemini
# signup: https://aistudio.google.com/apikey
# docs: https://ai.google.dev/gemini-api/docs
# pricing: https://ai.google.dev/gemini-api/docs/pricing
# free tier: a free plan for developers and small projects (some models are not on it); Google Search grounding free allowance: 500 requests a day shared by Gemini 2.5 Flash and Flash-Lite; 5,000 a month shared by Gemini 3 and newer models (as of 2026-10-31)
# rate limit: Gemini 3 and newer: a default cap of 1,500 grounded requests a day per project (as of 2026-10-31)
# required
# alternatives (any one): GOOGLE_API_KEY, GOOGLE_AI_API_KEY
GEMINI_API_KEY=
